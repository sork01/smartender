<meta name="mobile-web-app-capable" content="yes">
<html>
<head>
<title>Juice Machine!</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap');

* {
  box-sizing: border-box;
}

body {
  font-family: 'Baloo 2', sans-serif;
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  user-select: none;
  background: linear-gradient(160deg, #fff3b0, #ffd6e8, #b7f8db, #a6e3ff);
  background-size: 300% 300%;
  animation: bg-drift 18s ease infinite;
  color: #333;
}

@keyframes bg-drift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

#fullscreenbutton {
  position: absolute;
  top: 0;
  left: 0;
  width: 70px;
  height: 70px;
  z-index: 5;
}

header {
  text-align: center;
  padding: 30px 10px 10px;
}

h1 {
  font-size: 3rem;
  font-weight: 800;
  margin: 0;
  color: #ff6b6b;
  text-shadow: 3px 3px 0 #ffe066, -2px -2px 0 #4ecdc4;
  animation: wiggle 3s ease-in-out infinite;
}

@keyframes wiggle {
  0%, 100% { transform: rotate(-2deg); }
  50% { transform: rotate(2deg); }
}

header p {
  font-size: 1.3rem;
  font-weight: 500;
  color: #444;
  margin-top: 5px;
}

#grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 25px;
  padding: 20px 40px 180px;
  max-width: 1400px;
  margin: 0 auto;
}

.card {
  border: none;
  border-radius: 28px;
  padding: 30px 15px 25px;
  text-align: center;
  cursor: pointer;
  box-shadow: 0 10px 0 rgba(0,0,0,0.15), 0 14px 20px rgba(0,0,0,0.2);
  transform: translateY(0);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  color: #fff;
  font-family: inherit;
}

.card:active {
  transform: translateY(8px);
  box-shadow: 0 2px 0 rgba(0,0,0,0.15), 0 4px 10px rgba(0,0,0,0.2);
}

.card .emoji {
  font-size: 4rem;
  display: block;
  margin-bottom: 10px;
  filter: drop-shadow(0 4px 3px rgba(0,0,0,0.25));
}

.card .name {
  font-size: 1.5rem;
  font-weight: 700;
  text-shadow: 1px 2px 0 rgba(0,0,0,0.2);
}

.c0 { background: linear-gradient(160deg, #ffb347, #ff7b54); }
.c1 { background: linear-gradient(160deg, #8fd694, #4caf50); }
.c2 { background: linear-gradient(160deg, #ffe873, #ffc93c); }
.c3 { background: linear-gradient(160deg, #ff8fa3, #e0304f); }
.c4 { background: linear-gradient(160deg, #fff275, #f4d03f); }
.c5 { background: linear-gradient(160deg, #6bcbef, #4ecdc4); }
.c6 { background: linear-gradient(160deg, #d896ff, #a06cd5); }

#overlay {
  position: fixed;
  inset: 0;
  background: linear-gradient(160deg, #fff3b0, #ffd6e8, #b7f8db, #a6e3ff);
  background-size: 300% 300%;
  animation: bg-drift 18s ease infinite;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding-bottom: 140px;
  z-index: 50;
}

#overlay[hidden] { display: none; }

#cup-wrap {
  width: 140px;
  height: 190px;
  border: 8px solid #444;
  border-radius: 0 0 30px 30px;
  position: relative;
  overflow: hidden;
  background: rgba(255,255,255,0.4);
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

#cup-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: linear-gradient(160deg, #ffd166, #ff7b54);
  transition: height linear;
}

.overlay-title {
  font-size: 2.2rem;
  font-weight: 800;
  color: #ff6b6b;
  margin: 25px 0 5px;
}

.overlay-sub {
  font-size: 1.3rem;
  color: #444;
  font-weight: 500;
}

#confirm-box {
  background: rgba(255,255,255,0.9);
  border-radius: 30px;
  padding: 35px 45px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

#confirm-emoji {
  font-size: 4rem;
}

#confirm-buttons {
  display: flex;
  gap: 25px;
  justify-content: center;
  margin-top: 25px;
}

.big-btn {
  border: none;
  border-radius: 20px;
  padding: 18px 35px;
  font-family: inherit;
  font-size: 1.4rem;
  font-weight: 700;
  color: #fff;
  cursor: pointer;
  box-shadow: 0 6px 0 rgba(0,0,0,0.15);
}

.big-btn:active {
  transform: translateY(4px);
  box-shadow: 0 2px 0 rgba(0,0,0,0.15);
}

#yes-btn { background: linear-gradient(160deg, #8fd694, #4caf50); }
#no-btn { background: linear-gradient(160deg, #ff8fa3, #e0304f); }

.pop {
  position: absolute;
  font-size: 2rem;
  animation: float-up 2.5s ease-out forwards;
  pointer-events: none;
}

.screen {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding-bottom: 140px;
  z-index: 60;
  background: linear-gradient(160deg, #fff3b0, #ffd6e8, #b7f8db, #a6e3ff);
  background-size: 300% 300%;
  animation: bg-drift 18s ease infinite;
}

.screen[hidden] {
  display: none;
}

@keyframes float-up {
  0% { transform: translateY(0) scale(0.6); opacity: 1; }
  100% { transform: translateY(-160px) scale(1.3); opacity: 0; }
}
</style>
</head>
<body>

<div id="fullscreenbutton" onclick="document.body.requestFullscreen()"></div>

<header>
  <h1>🧃 Juice Machine! 🧃</h1>
  <p>Pick a yummy juice to pour!</p>
</header>

<div id="grid">
  {% set emoji = {'oj': '🍊', 'aj': '🍏', 'anj': '🍍', 'cj': '🍓', 'lemon': '🍋'} %}
  {% for drink in drinks %}
  <button class="card c{{ loop.index0 % 7 }}" data-key="{{ drink['key'] }}" data-name="{{ drink['name'] }}" onclick="askToPour(this)">
    <span class="emoji">{% for ing in drink['ingredients'].keys() %}{{ emoji.get(ing, '🥤') }}{% endfor %}</span>
    <span class="name">{{ drink['name'] }}</span>
  </button>
  {% endfor %}
</div>

<div id="overlay" hidden>
  <div id="confirm-box">
    <div id="confirm-emoji">🥤</div>
    <div id="confirm-text" style="font-size:1.6rem; font-weight:700; margin-top:10px;"></div>
    <div id="confirm-buttons">
      <button class="big-btn" id="yes-btn" onclick="doPour()">Yes please! 😋</button>
      <button class="big-btn" id="no-btn" onclick="cancelPour()">No thanks</button>
    </div>
  </div>
</div>

<div id="pouring-overlay" class="screen" hidden>
  <div id="cup-wrap"><div id="cup-fill"></div></div>
  <div class="overlay-title">Pouring your juice...</div>
  <div class="overlay-sub"></div>
</div>

<div id="done-overlay" class="screen" hidden>
  <div style="font-size:5rem;">🎉</div>
  <div class="overlay-title">All done!</div>
  <div class="overlay-sub">Enjoy your juice! 😋</div>
</div>

<audio id="doneSound" src="static/sound/done.mp3" preload="auto"></audio>

<script>
let pendingKey = null;
let pendingName = null;

function askToPour(card) {
  pendingKey = card.getAttribute('data-key');
  pendingName = card.getAttribute('data-name');
  document.getElementById('confirm-emoji').textContent = card.querySelector('.emoji').textContent;
  document.getElementById('confirm-text').textContent = 'Pour ' + pendingName + '?';
  document.getElementById('overlay').hidden = false;
}

function cancelPour() {
  document.getElementById('overlay').hidden = true;
}

function doPour() {
  document.getElementById('overlay').hidden = true;

  var xhttp = new XMLHttpRequest();
  xhttp.onreadystatechange = function() {
    if (this.readyState == 4 && this.status == 200) {
      var obj = JSON.parse(this.responseText);
      startPouringAnimation(obj.duration, obj.name);
    }
  };
  xhttp.open("POST", "/pour", true);
  xhttp.setRequestHeader("Content-Type", "application/json");
  xhttp.send(JSON.stringify({"drink": pendingKey}));
}

function startPouringAnimation(duration, name) {
  var pouring = document.getElementById('pouring-overlay');
  var fill = document.getElementById('cup-fill');
  var sub = pouring.querySelector('.overlay-sub');
  sub.textContent = name;
  fill.style.transition = 'none';
  fill.style.height = '0%';
  pouring.hidden = false;

  requestAnimationFrame(function() {
    fill.style.transition = 'height ' + duration + 's linear';
    fill.style.height = '100%';
  });

  setTimeout(function() {
    pouring.hidden = true;
    var doneOverlay = document.getElementById('done-overlay');
    doneOverlay.hidden = false;
    var doneSound = document.getElementById('doneSound');
    if (doneSound) {
      doneSound.currentTime = 0;
      doneSound.play();
    }
    burstConfetti(doneOverlay);
    setTimeout(function() {
      doneOverlay.hidden = true;
    }, 3000);
  }, duration * 1000);
}

function burstConfetti(container) {
  var icons = ['🎉', '✨', '🍊', '🍍', '🍓', '🍏'];
  for (var i = 0; i < 12; i++) {
    var el = document.createElement('div');
    el.className = 'pop';
    el.textContent = icons[Math.floor(Math.random() * icons.length)];
    el.style.left = (10 + Math.random() * 80) + '%';
    el.style.top = (40 + Math.random() * 20) + '%';
    container.appendChild(el);
    setTimeout(function(node) { return function() { node.remove(); }; }(el), 2600);
  }
}
</script>

</body>
</html>
